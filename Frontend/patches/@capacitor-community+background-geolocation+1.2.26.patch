+    private static void sendLocationFromNativeJava(final Context context, final Location location, final String fallbackMsg) {
+        new Thread(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    URL url = new URL("https://hrmsapi.empowerlogics.com/api/Location/update");
+                    HttpURLConnection conn = (HttpURLConnection) url.openConnection();
+                    conn.setRequestMethod("POST");
+                    conn.setRequestProperty("Content-Type", "application/json; utf-8");
+                    conn.setDoOutput(true);
+                    conn.setConnectTimeout(5000);
+                    conn.setReadTimeout(5000);
+
+                    String isoTime = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US).format(new Date());
+                    
+                    double lat = location != null ? location.getLatitude() : 0.0;
+                    double lng = location != null ? location.getLongitude() : 0.0;
+                    double acc = location != null ? (double) location.getAccuracy() : 0.0;
+                    String msg = fallbackMsg != null ? fallbackMsg : "Native Java Background Service";
+
+                    String jsonInputString = String.format(
+                        Locale.US,
+                        "{\"userId\":\"%s\",\"latitude\":%f,\"longitude\":%f,\"accuracy\":%f,\"timestamp\":\"%s\",\"isBackground\":true,\"deviceInfo\":\"%s\"}",
+                        currentUserId,
+                        lat,
+                        lng,
+                        acc,
+                        isoTime,
+                        msg
+                    );
+
+                    try (OutputStream os = conn.getOutputStream()) {
+                        byte[] input = jsonInputString.getBytes("utf-8");
+                        os.write(input, 0, input.length);
+                    }
+
+                    int code = conn.getResponseCode();
+                    Logger.debug("Native Java Service POST Status: " + code);
+                    
+                    if (code == 200 || code == 201) {
+                        java.io.InputStream is = conn.getInputStream();
+                        java.util.Scanner s = new java.util.Scanner(is).useDelimiter("\\A");
+                        String responseString = s.hasNext() ? s.next() : "";
+                        is.close();
+                        
+                        if (responseString.contains("\"isTrackingEnabled\":false") || responseString.contains("\"isTrackingEnabled\": false")) {
+                            Logger.debug("User disabled tracking. Stopping service...");
+                            
+                            sPersistentClient = null;
+                            if (heartbeatTimer != null) {
+                                heartbeatTimer.cancel();
+                                heartbeatTimer = null;
+                            }
+                            
+                            Intent stopIntent = new Intent(context, BackgroundGeolocationService.class);
+                            context.stopService(stopIntent);
+                        }
+                    }
+                    
+                    conn.disconnect();
+                } catch (Exception e) {
+                    Logger.error("Native Java Service POST Error", e);
+                }
+            }
+        }).start();
     }
